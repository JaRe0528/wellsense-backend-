{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=wellsense;Username=wellsense_app;Password=__SET_VIA_USER_SECRETS_OR_ENV__"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Jwt": {
    "Issuer": "WellSense.Api",
    "Audience": "WellSense.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "Secret": "__SET_VIA_USER_SECRETS_OR_VAULT__ (mínimo 32 bytes aleatorios, nunca versionar el valor real)"
  },
  "DeviceLink": {
    "Pepper": "__SET_VIA_USER_SECRETS_OR_VAULT__ (nunca versionar el valor real, ver HANDOFF-DB §7)"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "post:/api/v1/auth/login",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "post:/api/v1/auth/register",
        "Period": "1h",
        "Limit": 5
      },
      {
        "Endpoint": "post:/api/v1/auth/forgot-password",
        "Period": "1h",
        "Limit": 5
      },
      {
        "Endpoint": "post:/api/v1/auth/reset-password",
        "Period": "1h",
        "Limit": 10
      },
      {
        "Endpoint": "post:/api/v1/auth/device-link/redeem",
        "Period": "1m",
        "Limit": 5
      }
    ]
  },
  "_comments": {
    "device_link_redeem_rate_limit": "P0 no negociable (HANDOFF-DB §8 riesgo 7 y HANDOFF de este bloque): es la única defensa real contra fuerza bruta de códigos de 6 dígitos, ya que `attempts` no puede atribuir intentos con dígitos incorrectos a ninguna fila."
  }
}
