<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WellSense.Api</RootNamespace>
    <UserSecretsId>wellsense-api-secrets</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="8.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <!-- Barrido completo de usings-vs-paquetes: estos tres ya se usaban directo aquí
         (FluentValidation.ValidationException en Middleware, MediatR.ISender en los
         controladores, Microsoft.IdentityModel.Tokens.SymmetricSecurityKey/
         TokenValidationParameters en Program.cs) y probablemente ya llegaban
         transitivos (FluentValidation/MediatR vía Application a través de
         Infrastructure; Microsoft.IdentityModel.Tokens vía el propio paquete
         JwtBearer de arriba), pero se referencian explícitos para no dejarlo a la
         suerte de la cadena de ProjectReference. -->
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WellSense.Infrastructure\WellSense.Infrastructure.csproj" />
  </ItemGroup>
</Project>
