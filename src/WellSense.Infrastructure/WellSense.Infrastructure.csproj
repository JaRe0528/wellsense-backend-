<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WellSense.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
    <PackageReference Include="EFCore.NamingConventions" Version="9.0.0" />
    <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <!-- Fix del error reportado: JwtSecurityTokenHandler/JwtSecurityToken
         (System.IdentityModel.Tokens.Jwt) y, transitivamente, SymmetricSecurityKey/
         SigningCredentials (Microsoft.IdentityModel.Tokens) que ya se usaban en
         JwtTokenService.cs sin este paquete. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <!-- Barrido completo de usings-vs-paquetes de este .csproj (pedido tras dos
         rondas de "falta un paquete"): estos tres ya se usaban directo en
         Infrastructure (IConfiguration en DeviceLinkCodeHasher/JwtTokenService/
         DependencyInjection.cs, ILogger<T> en LoggingEmailSender, IServiceCollection
         en DependencyInjection.cs) y aunque probablemente ya llegaban transitivos vía
         el ProjectReference a Application, se referencian aquí de forma explícita
         para no depender de qué paquetes decida traer un proyecto que ni siquiera es
         el que los consume directamente. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <!-- Bloque 5 (SignalR+FCM): SDK oficial de Firebase Admin para .NET — trae
         FirebaseAdmin.Messaging (envío real de push) y, transitivamente,
         Google.Apis.Auth (GoogleCredential para las credenciales de la cuenta de
         servicio). Ver FirebaseCloudMessagingSender.cs. -->
    <PackageReference Include="FirebaseAdmin" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WellSense.Application\WellSense.Application.csproj" />
  </ItemGroup>
</Project>
